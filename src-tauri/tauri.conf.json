{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Financial Blogger Agent",
  "version": "0.1.0",
  "identifier": "com.financialblogger.agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Financial Blogger Agent",
        "width": 1160,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/binance-square"],
    "icon": []
  }
}
